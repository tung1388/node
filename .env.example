# Personal access token with `contents:write` on GITHUB_REPO.
GITHUB_TOKEN=

# The dedicated repo you create for this app+media, e.g.
# GITHUB_OWNER=yourname, GITHUB_REPO=node-blobs
GITHUB_OWNER=
GITHUB_REPO=

# This is a single-folder instance (unlike the general githost, which
# supports multiple folders/users) - one folder:key pair is all you need.
# The key is any string (padded/truncated to 32 bytes); whoever holds it
# can decrypt everything under blobs/node/.
# Example: ENCRYPTION_KEYS=node:some-long-random-passphrase
ENCRYPTION_KEYS=node:CHANGE_ME
